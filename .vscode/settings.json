{
  // Папки с библиотеками и служебными файлами: VS Code не следит за ними и не ищет в них — меньше памяти
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/node_modules": true
  },
  "files.exclude": {
    "**/__pycache__": true
  },

  // Python: окружение бэкенда (backend/.venv), проверяются только открытые файлы, библиотеки из .venv не разбираются целиком.
  // extraPaths — чтобы VS Code находил модули бэкенда (import db, from routes import ...)
  "python.defaultInterpreterPath": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
  "python.analysis.extraPaths": ["backend"],
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": ["**/.venv", "**/__pycache__", "**/node_modules"],
  "python.analysis.indexing": false
}
