# Подключение к базе данных PostgreSQL
DATABASE_URL=postgres://fit:fit@localhost:5432/fitdiary_web

# Подключение к Redis (там хранятся токены входа)
REDIS_URL=redis://localhost:6379/0

# Порт API
PORT=3000

# С каких адресов браузеру можно обращаться к API: сайт (web) и мобильное приложение в браузере (mobile)
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
