{
  "name": "fit-diary-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Дневник тренировок — бэкенд (Python + Flask, PostgreSQL, Redis). Общий для сайта (web) и мобильного приложения (mobile)",
  "scripts": {
    "setup": "python -m venv .venv && .venv\\Scripts\\python -m pip install -r requirements.txt",
    "redis": "docker compose up -d",
    "dev": ".venv\\Scripts\\python app.py",
    "db:create": ".venv\\Scripts\\python -m database.create_tables",
    "db:seed": ".venv\\Scripts\\python -m database.seed"
  }
}
